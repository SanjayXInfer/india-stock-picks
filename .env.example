# Copy to .env (which is git-ignored) and fill in. Never commit .env.

# Optional. Without it, the regex/heuristic extractor is used.
ANTHROPIC_API_KEY=

# Optional. Model used for extraction (default: claude-haiku-5-5).
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional. A public URL identifying this project, appended to the User-Agent
# (e.g. your GitHub repo URL). Do NOT put a personal email here.
# CONTACT_URL=https://github.com/<you>/<repo>

# Optional. Fetch delayed prices from Yahoo Finance to compute upside (default: 1).
# FETCH_PRICES=1

# Optional. Local server port (default: 8000).
# PORT=8000
